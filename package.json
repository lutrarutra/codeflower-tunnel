{
  "name": "codeflower-tunnel",
  "version": "0.1.0",
  "description": "code flower's tunnel: reach your sandboxes from anywhere through an end-to-end encrypted relay",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": "github:lutrarutra/codeflower-tunnel",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node src/node.ts",
    "dev:node": "TUNNEL_DB=.dev/tunnel.sqlite PUBLIC_URL=http://localhost:8787 COOKIE_SECRET=dev-only-secret-dev-only-secret node --watch src/node.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler d1 migrations apply codeflower-tunnel --remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "vendor-ui": "node scripts/vendor-ui.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0",
    "ws": "^8.22.1"
  }
}
